# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to source control.
DB_CONNECTION_STRING='Data Source=your_db.sqlite3'
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_chars
JWT_EXPIRY_MINUTES=60

# Optional: used only for automatic first-admin seeding at startup.
# Prefer `dotnet run -- create-admin` for interactive admin creation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_secure_password
